# Public URL used for canonicals, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://seapebbles.co.uk

# Reservation emails are sent through Resend (https://resend.com). Without a key,
# development logs requests to the console and production shows a "please call" error.
RESEND_API_KEY=
RESERVATIONS_TO_EMAIL=info@seapebbles.co.uk
RESERVATIONS_FROM_EMAIL="Sea Pebbles Website <reservations@seapebbles.co.uk>"
