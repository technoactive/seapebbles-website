# Public URL used for canonicals, sitemap, Open Graph and structured data.
# Optional: the build falls back to the production domain.
NEXT_PUBLIC_SITE_URL=https://seapebbles.co.uk

# Form emails are sent through Resend (https://resend.com). Required in production.
# Without a key, development logs the message to the console instead of sending.
RESEND_API_KEY=

# Optional overrides. Defaults are shown; all addresses are on the verified domain.
# MAIL_FROM is the send-only sender for notifications to the restaurant.
# Guests receive their acknowledgement from the *_TO mailbox itself so they can reply.
# MAIL_FROM="Sea Pebbles <website@seapebbles.co.uk>"
# RESERVATIONS_TO_EMAIL=reservations@seapebbles.co.uk
# CONTACT_TO_EMAIL=info@seapebbles.co.uk
